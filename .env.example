# Apex domain; businesses are served at <slug>.<ROOT_DOMAIN>. Read at runtime.
ROOT_DOMAIN=cgmenu.tr

# Inlined at build time
NEXT_PUBLIC_SITE_URL=https://cgmenu.tr
NEXT_PUBLIC_APP_URL=https://app.cgmenu.tr
NEXT_PUBLIC_DEMO_URL=https://demo.cgmenu.tr
NEXT_PUBLIC_CONTACT_EMAIL=info@cgmenu.tr
NEXT_PUBLIC_API_URL=https://api.cgmenu.tr

# Read at runtime, server only
# API address from inside the server/network; defaults to NEXT_PUBLIC_API_URL
API_INTERNAL_URL=
# Shared with cgmenu-api (REVALIDATE_SECRET); protects POST /api/revalidate
REVALIDATE_SECRET=
